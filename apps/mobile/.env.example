# Copie para `.env` (fora do git). Só valores PÚBLICOS: eles vão dentro do app.
# Nunca coloque aqui service role, chave da Anthropic ou da Meta.

# Supabase. Local: `pnpm db:start`. No celular, troque 127.0.0.1 pelo IP do
# computador na rede (ex.: http://192.168.0.10:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Login com Google (docs/setup.md, item 4). IDs de cliente não são secretos.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Identificadores provisórios (D14).
APP_BUNDLE_ID=br.com.srcasamentos.app.dev
APP_SCHEME=srcasamentos

# Endereço do site (links de convite e página de exclusão de conta).
EXPO_PUBLIC_SITE_URL=http://localhost:3000
